{
    "name": "vigil",
    "main": "./src/worker/index.ts",
    "compatibility_date": "2025-09-01",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "assets": {
        "not_found_handling": "single-page-application",
        "run_worker_first": [
            "/api/*",
            "/_v/*"
        ]
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "vigil",
            "database_id": "f9339688-8263-4602-b80e-91940498bd9e",
            "migrations_dir": "migrations"
        }
    ],
    "vars": {
        "ALLOWED_SITES": "joodaloop.com,anjalishriva.com"
    }
}
