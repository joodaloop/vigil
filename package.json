{
    "name": "vigil",
    "private": true,
    "license": "MIT",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "deploy": "vite build && wrangler d1 migrations apply DB --remote && wrangler deploy",
        "deploy:prod": "WRANGLER_CONFIG=wrangler.prod.json vite build && wrangler d1 migrations apply DB --remote -c wrangler.prod.json && wrangler deploy",
        "db:migrate": "wrangler d1 migrations apply DB --local",
        "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
        "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/*.test.mjs",
        "types:gen": "wrangler types"
    },
    "dependencies": {
        "@solidjs/web": "2.0.0-rc.13",
        "solid-js": "2.0.0-rc.13",
        "ua-parser-js": "^1.0.38",
        "uplot": "^1.6.32"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.39.0",
        "@cloudflare/workers-types": "^4.20250803.0",
        "@solidjs/vite-plugin": "3.0.0-next.47",
        "@types/node": "^26.6.4",
        "@types/ua-parser-js": "^0.7.39",
        "typescript": "^5.7.2",
        "vite": "^8.0.14",
        "wrangler": "^4.95.0"
    },
    "cloudflare": {
        "bindings": {
            "COOKIE_SECRET": {
                "description": "Signs the visitor cookie. Use a long random string, e.g. the output of `openssl rand -base64 32`."
            },
            "SITES": {
                "description": "The sites to accept hits from and show on the dashboard. Edit it in `wrangler.json` after deploying; see the README."
            }
        }
    },
    "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882"
}
